{
    "name": "hugoseigle/symfony-import-export-bundle",
    "description": "Import and export Doctrine entities from Excel and CSV in Symfony applications.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "csv",
        "excel",
        "import",
        "export",
        "spreadsheet",
        "doctrine"
    ],
    "authors": [
        {
            "name": "Hugo SEIGLE",
            "email": "hugo.seigle03@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^3.2",
        "phpoffice/phpspreadsheet": "^2.3.5",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-csrf": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^2.5 || ^3.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpro/grumphp": "^2.16",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HugoSEIGLE\\SymfonyImportExportBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HugoSEIGLE\\SymfonyImportExportBundle\\Benchmarks\\": "benchmarks/src/",
            "HugoSEIGLE\\SymfonyImportExportBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "phpro/grumphp": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.* || 7.* || 8.*"
        }
    },
    "scripts": {
        "benchmark": "php benchmarks/run.php",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:coverage": "phpunit --configuration phpunit.xml.dist --coverage-clover coverage.xml"
    }
}
