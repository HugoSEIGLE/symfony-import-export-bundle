{
    "name": "hugoseigle/import-export-demo",
    "description": "Demo application for the Symfony Import Export Bundle.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "doctrine/dbal": "^3.8.2",
        "doctrine/doctrine-bundle": "^2.13",
        "hugoseigle/symfony-import-export-bundle": "dev-main",
        "symfony/console": "6.4.*",
        "symfony/dotenv": "6.4.*",
        "symfony/form": "6.4.*",
        "symfony/flex": "^2.5",
        "symfony/framework-bundle": "6.4.*",
        "symfony/runtime": "6.4.*",
        "symfony/security-csrf": "6.4.*",
        "symfony/translation": "6.4.*",
        "symfony/twig-bundle": "6.4.*",
        "symfony/validator": "6.4.*",
        "symfony/var-exporter": "6.4.*",
        "symfony/yaml": "6.4.*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.4.*"
        }
    },
    "scripts": {
        "setup": [
            "@php bin/console doctrine:schema:update --force",
            "@php bin/console app:seed-demo"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
