<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Import Export Demo</title>
    <style>
        :root { color-scheme: light; --ink: #18212f; --muted: #697386; --line: #e7eaf0; --blue: #3157d5; --blue-soft: #eef2ff; --green: #15805d; }
        * { box-sizing: border-box; }
        body { margin: 0; background: #f5f7fb; color: var(--ink); font: 15px/1.5 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        a { color: inherit; text-decoration: none; }
        .shell { width: min(1180px, calc(100% - 48px)); margin: 0 auto; }
        header { background: #111827; color: white; }
        nav { height: 68px; display: flex; align-items: center; justify-content: space-between; }
        .brand { display: flex; align-items: center; gap: 12px; font-weight: 750; letter-spacing: -.02em; }
        .mark { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; background: #4f6ee8; font-size: 18px; }
        .nav-note { color: #aeb7c6; font-size: 13px; }
        main { padding: 48px 0 64px; }
        .hero { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-bottom: 30px; }
        .eyebrow { margin: 0 0 7px; color: var(--blue); font-size: 12px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
        h1 { margin: 0; font-size: clamp(32px, 4vw, 46px); line-height: 1.08; letter-spacing: -.045em; }
        .subtitle { max-width: 650px; margin: 12px 0 0; color: var(--muted); font-size: 17px; }
        .export-group { display: flex; gap: 9px; flex: 0 0 auto; }
        .button { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 16px; border: 1px solid #d6dbe5; border-radius: 10px; background: white; font-weight: 700; cursor: pointer; }
        .button.primary { border-color: var(--blue); background: var(--blue); color: white; }
        .button:hover { transform: translateY(-1px); box-shadow: 0 5px 15px rgb(29 45 79 / 10%); }
        .grid { display: grid; grid-template-columns: 360px 1fr; gap: 22px; align-items: start; }
        .card { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: white; box-shadow: 0 8px 30px rgb(25 35 58 / 6%); }
        .card-body { padding: 24px; }
        .card h2 { margin: 0; font-size: 18px; letter-spacing: -.02em; }
        .card-copy { margin: 7px 0 20px; color: var(--muted); font-size: 13px; }
        .dropzone { padding: 28px 18px; border: 1.5px dashed #bcc5d6; border-radius: 12px; background: #fafbfe; text-align: center; }
        .upload-icon { width: 46px; height: 46px; display: grid; place-items: center; margin: 0 auto 11px; border-radius: 13px; background: var(--blue-soft); color: var(--blue); font-size: 22px; }
        input[type=file] { width: 100%; color: var(--muted); font-size: 12px; }
        input[type=file]::file-selector-button { margin: 0 8px 10px 0; padding: 8px 11px; border: 1px solid #d6dbe5; border-radius: 8px; background: white; color: var(--ink); font-weight: 650; cursor: pointer; }
        .submit { width: 100%; margin-top: 14px; }
        .templates { display: flex; gap: 9px; margin-top: 14px; }
        .templates .button { flex: 1; min-height: 38px; color: var(--blue); font-size: 12px; }
        .flash { margin-bottom: 16px; padding: 12px 15px; border-radius: 10px; font-weight: 650; }
        .flash.success { background: #eaf8f2; color: #116149; }
        .flash.error { background: #fff0f0; color: #a12727; }
        .table-head { display: flex; align-items: center; justify-content: space-between; padding: 21px 24px; border-bottom: 1px solid var(--line); }
        .count { padding: 4px 9px; border-radius: 999px; background: var(--blue-soft); color: var(--blue); font-size: 12px; font-weight: 800; }
        table { width: 100%; border-collapse: collapse; }
        th { padding: 12px 18px; background: #fafbfc; color: #81899a; font-size: 11px; letter-spacing: .06em; text-align: left; text-transform: uppercase; }
        td { padding: 15px 18px; border-top: 1px solid #f0f2f5; }
        tbody tr:hover { background: #fafbff; }
        .company { font-weight: 750; }
        .email { color: var(--muted); font-size: 13px; }
        .pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 999px; background: #ecf8f3; color: var(--green); font-size: 11px; font-weight: 800; }
        .pill::before { width: 6px; height: 6px; border-radius: 50%; background: currentColor; content: ""; }
        .pill.off { background: #f2f3f5; color: #7c8492; }
        .number { font-variant-numeric: tabular-nums; }
        @media (max-width: 850px) { .hero { align-items: start; flex-direction: column; } .grid { grid-template-columns: 1fr; } .nav-note { display: none; } }
    </style>
</head>
<body>
<header>
    <nav class="shell">
        <div class="brand"><span class="mark">↕</span> Symfony Import Export</div>
        <div class="nav-note">CSV &amp; XLSX · powered by Doctrine and Symfony Forms</div>
    </nav>
</header>
<main class="shell">
    <section class="hero">
        <div>
            <p class="eyebrow">Bundle demo</p>
            <h1>Company directory</h1>
            <p class="subtitle">Import validated company data, then export the complete directory in the format your team needs.</p>
        </div>
        <div class="export-group">
            <a class="button" href="{{ path('app_export', {format: 'csv'}) }}">↓ Export CSV</a>
            <a class="button primary" href="{{ path('app_export', {format: 'xlsx'}) }}">↓ Export XLSX</a>
        </div>
    </section>

    {% for message in app.flashes('success') %}<div class="flash success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="flash error">{{ message }}</div>{% endfor %}

    <div class="grid">
        <section class="card">
            <div class="card-body">
                <h2>Import companies</h2>
                <p class="card-copy">Upload a UTF-8 CSV or an Excel workbook. Existing rows are matched by email.</p>
                <form action="{{ path('app_import') }}" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="_token" value="{{ csrf_token('company-import') }}">
                    <div class="dropzone">
                        <div class="upload-icon">↑</div>
                        <input type="file" name="file" accept=".csv,.xlsx" required>
                    </div>
                    <button class="button primary submit" type="submit">Import file</button>
                </form>
                <div class="templates">
                    <a class="button" href="{{ path('app_template', {format: 'csv'}) }}">CSV template</a>
                    <a class="button" href="{{ path('app_template', {format: 'xlsx'}) }}">XLSX template</a>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="table-head">
                <h2>Companies</h2>
                <span class="count">{{ companies|length }} records</span>
            </div>
            <table>
                <thead><tr><th>Company</th><th>Industry</th><th>Employees</th><th>Status</th></tr></thead>
                <tbody>
                {% for company in companies %}
                    <tr>
                        <td><div class="company">{{ company.name }}</div><div class="email">{{ company.email }}</div></td>
                        <td>{{ company.industry }}</td>
                        <td class="number">{{ company.employees }}</td>
                        <td><span class="pill {{ company.active ? '' : 'off' }}">{{ company.active ? 'Active' : 'Inactive' }}</span></td>
                    </tr>
                {% else %}
                    <tr><td colspan="4">Run <code>composer setup</code> to load the demo data.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </section>
    </div>
</main>
</body>
</html>
